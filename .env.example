# Storefront compose env (backend-centrifungal + static-centrifungal).
# Copy to .env on the VPS and fill in. Never commit real values (public repo).

# Traefik routing + certs
CLIENT_DOMAIN=centrifungal.dev.skeleton-crew.co.uk
CERT_RESOLVER=letsencrypt-staging   # dev; promote to letsencrypt-prod at launch

# --- Backend (checkout/contact API) ---
# Stripe (test keys for dev; live keys only at prod cutover)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (transactional email)
RESEND_API_KEY=
FROM_EMAIL=hello@centrifungal.co.uk

# Payload CMS - reached over the internal Docker network (container name).
PAYLOAD_API_URL=http://payload-centrifungal:3000/api
PAYLOAD_API_KEY=

# Storefront URL - Stripe success/cancel redirects + CORS.
SITE_URL=https://centrifungal.dev.skeleton-crew.co.uk

# Optional: contact/order-alert recipient (falls back to SiteSettings.contactEmail).
CONTACT_RECIPIENT=

# Optional: Royal Mail Click & Drop (both empty => dispatch/tracking cron no-ops).
ROYAL_MAIL_API_KEY=
ROYAL_MAIL_API_URL=

PORT=3001
NODE_ENV=production
