# Centrifungal checkout/contact backend - environment.
# Never commit real values (public repo). On the VPS these live in the
# storefront compose env_file / secrets.

# Stripe (test keys for dev; live keys only at prod cutover)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (transactional email)
RESEND_API_KEY=
FROM_EMAIL=hello@centrifungal.co.uk

# Payload CMS - reached over the internal Docker network (container name).
PAYLOAD_API_URL=http://payload-centrifungal:3000/api
PAYLOAD_API_KEY=

# Storefront URL - used for Stripe success/cancel redirects and CORS.
SITE_URL=https://centrifungal.dev.skeleton-crew.co.uk

# Optional: override the contact-form / order-alert recipient. Falls back to
# SiteSettings.contactEmail in the CMS if unset.
CONTACT_RECIPIENT=

# Optional: Royal Mail Click & Drop. If either is unset the dispatch/tracking
# cron logs a warning and no-ops (checkout + emails still work).
ROYAL_MAIL_API_KEY=
ROYAL_MAIL_API_URL=

PORT=3001
NODE_ENV=development
