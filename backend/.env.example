# Centrifungal checkout/contact backend. Never commit real values.

# Stripe (test keys for dev; live keys only at prod cutover)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (transactional email) and where owner alerts and contact messages go
RESEND_API_KEY=
FROM_EMAIL=hello@centrifungal.co.uk
CONTACT_RECIPIENT=hello@centrifungal.co.uk

# Storefront URL - Stripe success/cancel redirects and CORS
SITE_URL=https://centrifungal.dev.skeleton-crew.co.uk

# Catalogue published by the static build. Inside Docker use the static container's hostname so
# the backend never leaves the box. Dev can point at a local file instead.
CATALOGUE_URL=http://static-centrifungal/catalogue.json
# CATALOGUE_FILE=../out/catalogue.json
CATALOGUE_TTL_SECONDS=3600

# SQLite ledger (sold-out overrides, order fulfilment state). The Dockerfile sets /data/... on a volume.
DB_PATH=./data/centrifungal.sqlite

# Set to enable POST /api/admin/stock, GET /api/admin/orders and POST /api/admin/catalogue/refresh.
# Use: curl -H "Authorization: Bearer $ADMIN_TOKEN" -d '{"slug":"...","sku":"...","soldOut":true}' .../api/admin/stock
ADMIN_TOKEN=

FREE_SHIPPING_THRESHOLD_PENCE=5000

# Optional: Royal Mail Click & Drop. If either is unset the dispatch/tracking cron logs and no-ops.
ROYAL_MAIL_API_KEY=
ROYAL_MAIL_API_URL=

PORT=3001
NODE_ENV=development
